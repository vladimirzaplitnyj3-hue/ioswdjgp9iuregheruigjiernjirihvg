    ]}

def group_join_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Я участвую в сопровождении", "callback_data": f"join_{pid}", "style": "success", "icon_custom_emoji_id": EMOJI_USER}]
    ]}

# ========== ОТПРАВКА ГЛАВНОГО МЕНЮ С ФОТО И ПОДПИСЬЮ ==========

def send_main_menu(chat_id):
    """
    Отправляет ФОТО + приветственный ТЕКСТ (caption) + кнопки.
    Если фото не грузится — отправляет текст без фото.
    """
    global PHOTO_FILE_ID
    
    logger.info(f"📸 send_main_menu → {chat_id}, file_id={PHOTO_FILE_ID}")
    
    clear_last_message(chat_id)
    
    photo = PHOTO_FILE_ID or PHOTO_URL
    
    # Пытаемся отправить фото + caption + кнопки
    r = send_photo(chat_id, photo, caption=MAIN_CAPTION, reply_markup=main_menu())
    
    if r.get("ok"):
        logger.info(f"✅ Фото+caption отправлено в {chat_id}")
        if not PHOTO_FILE_ID:
            try:
                PHOTO_FILE_ID = r["result"]["photo"][-1]["file_id"]
                logger.info(f"💾 file_id: {PHOTO_FILE_ID}")
                logger.info(f"💾 Вставь в код: PHOTO_FILE_ID = \"{PHOTO_FILE_ID}\"")
            except Exception as e:
                logger.error(f"⚠️ file_id не сохранён: {e}")
        remember_message(chat_id, r["result"]["message_id"])
    else:
        logger.error(f"❌ Фото не отправлено: {r.get('description')}")
        # Отправляем только текст с кнопками
        r2 = send_message(chat_id, MAIN_TEXT, main_menu())
        if r2.get("ok"):
            remember_message(chat_id, r2["result"]["message_id"])
            logger.info(f"✅ Отправлен текст без фото")
    return r

def send_replacing(chat_id, text, reply_markup=None):
    clear_last_message(chat_id)
    r = send_message(chat_id, text, reply_markup)
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return r

# ========== ЛОГИКА ПОКУПКИ ==========

def start_purchase(chat_id, itype, ikey, iname, price):
    """Начинает покупку — показывает реквизиты + кнопки оплаты"""
    clear_last_message(chat_id)
    pid = gen_order_id()
    orders[pid] = {
        "user_id": chat_id,
        "type": itype,
        "item_key": ikey,
        "item_name": iname,
        "price": price,
        "status": "awaiting_payment",
        "created_at": datetime.datetime.now().isoformat()
    }
    logger.info(f"🛒 Заказ {pid}: {iname} — {price}₽ от {chat_id}")
    
    text = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>ОПЛАТА ЗАКАЗА</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: <b>{iname}</b>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: <b>{price} ₽</b>\n\n'
        f'<b>Реквизиты для оплаты:</b>\n'
        f'💳 Сбер Карта: <code>{PAY_CARD}</code>\n'
        f'📱 Сбер Телефон: <code>{PAY_PHONE}</code>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> После оплаты нажмите «Я оплатил»'
    )
    r = send_message(chat_id, text, payment_menu(pid))
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return pid

def process_paid(chat_id, cb_id, pid):
    """Пользователь нажал «Я оплатил» — отправляем владельцу"""
    o = orders.get(pid)
    if not o or o["status"] != "awaiting_payment":
        answer_callback(cb_id, "⚠️ Заказ не активен", True)
        return
    
    o["status"] = "awaiting_owner_confirm"
    o["username"] = get_username(chat_id)
    logger.info(f"💰 {pid}: {chat_id} нажал Я оплатил")
    
    owner_text = (
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> @{o["username"]}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> {o["item_name"]}\n'
        f'Сумма: {o["price"]} ₽\n\nПришли ли вам деньги?'
    )
    send_message(OWNER_ID, owner_text, owner_confirm_menu(pid))
    answer_callback(cb_id, "✅ Отправлено владельцу")
    send_replacing(
        chat_id,
        f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидайте подтверждения оплаты...'
    )

def owner_confirm(cb_id, pid, yes):
    """Владелец подтвердил или отклонил оплату"""
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Заказ не найден", True)
        return
    
    if yes:
        o["status"] = "awaiting_pubg_id"
        logger.info(f"✅ {pid}: владелец подтвердил оплату")
        send_message(
            o["user_id"],
            f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш заказ оплачен!</b>\n\n'
            f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Скоро вам придёт QR-код.\n'
            f'Зайдите в игру и вставьте этот QR-код.\n\n'
            f'<tg-emoji emoji-id="{EMOJI_USER}">🆔</tg-emoji> Введите ваш PUBG ID (только цифры, до 25):'
        )
        answer_callback(cb_id, "✅ Да, подтверждено")
    else:
        o["status"] = "rejected"
        logger.info(f"❌ {pid}: владелец отклонил оплату")
        send_message(
            o["user_id"],
            f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Заказ отменён</b>\n\nДеньги не поступили.'
        )
        answer_callback(cb_id, "❌ Отменено")

def process_pubg_id(chat_id, pid_text):
    """Пользователь ввёл PUBG ID — отправляем в группу сопровождающих"""
    uid = str(chat_id)
    o = None
    key = None
    for k, v in orders.items():
        if str(v.get("user_id")) == uid and v.get("status") == "awaiting_pubg_id":
            o = v
            key = k
            break
    
    if not o:
        return False
    
    o["pubg_id"] = pid_text
    o["status"] = "in_group"
    uname = o.get("username", "user")
    logger.info(f"🆔 {key}: PUBG ID {pid_text} от {chat_id}")
    
    # Отправляем в группу сопровождающих
    gt = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Купил: @{uname}\n'
        f'🆔 PUBG ID: <code>{pid_text}</code>\n'
        f'📦 Товар: {o["item_name"]}\n'
        f'💰 Цена: {o["price"]} ₽\n\n'
        f'Участвуют в сопровождении: @{uname}'
    )
    r = send_message(GROUP_ID, gt, group_join_menu(key))
    if r.get("ok"):
        group_messages[key] = {"message_id": r["result"]["message_id"], "parts": [f"@{uname}"]}
        logger.info(f"✅ {key}: отправлено в группу {GROUP_ID}")
    else:
        logger.error(f"❌ {key}: не отправлено в группу: {r.get('description')}")
    
    send_message(
        chat_id,
        f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш ID принят!</b>\n\n'
        f'Ожидайте QR-код от владельца.'
    )
    return True

def process_join(chat_id, cb_id, pid):
    """Кто-то нажал «Я участвую» в группе"""
    if pid not in group_messages:
        answer_callback(cb_id, "❌ Заказ не найден", True)
        return
    
    gm = group_messages[pid]
    uname = f"@{get_username(chat_id)}"
    
    if uname in gm["parts"]:
        answer_callback(cb_id, "⚠️ Вы уже участвуете", True)
        return
    
    if len(gm["parts"]) >= 3:
        answer_callback(cb_id, "❌ Мест нет (максимум 3)", True)
        return
    
    gm["parts"].append(uname)
    answer_callback(cb_id, f"✅ Участвуете! ({len(gm['parts'])}/3)")
    logger.info(f"👥 {pid}: {uname} присоединился ({len(gm['parts'])}/3)")
    
    o = orders.get(pid, {})
    nt = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Купил: @{o.get("username", "—")}\n'
        f'🆔 PUBG ID: <code>{o.get("pubg_id", "—")}</code>\n'
        f'📦 Товар: {o.get("item_name", "—")}\n'
        f'💰 Цена: {o.get("price", "—")} ₽\n\n'
        f'Участвуют в сопровождении: {", ".join(gm["parts"])} ({len(gm["parts"])}/3)'
    )
    markup = None if len(gm["parts"]) >= 3 else group_join_menu(pid)
    p = {"chat_id": GROUP_ID, "message_id": gm["message_id"], "text": nt, "parse_mode": "HTML"}
    if markup:
        p["reply_markup"] = json.dumps(markup)
    api_request("editMessageText", p, log_full=False)

def owner_send_qr(file_id, caption=""):
    """Владелец прислал фото — рассылаем всем в статусе in_group/awaiting_qr"""
    cnt = 0
    for pid, o in list(orders.items()):
        if o.get("status") in ("in_group", "awaiting_qr"):
            send_photo(
                o["user_id"], file_id,
                caption=f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> <b>Ваш QR-код!</b>\n\n'
                        f'У вас 5 минут, чтобы использовать этот QR-код, иначе придётся заново.\n\n'
                        + (caption or "")
            )
            o["status"] = "awaiting_done"
            send_message(OWNER_ID, f'✅ QR отправлен (заказ {pid})', owner_done_menu(pid))
            logger.info(f"📸 QR → {o['user_id']} (заказ {pid})")
            cnt += 1
    if cnt == 0:
        send_message(OWNER_ID, "⚠️ Нет активных заказов для QR")
        logger.warning("⚠️ Владелец прислал фото, но активных заказов не было")

def owner_done(cb_id, pid, yes):
    """Владелец подтвердил выполнение"""
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    
    if yes:
        o["status"] = "completed"
        logger.info(f"✅ {pid}: заказ выполнен")
        send_message(
            o["user_id"],
            f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш заказ выполнен!</b>\n\n'
            f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> Спасибо за покупку!'
        )
        answer_callback(cb_id, "✅ Заказ закрыт")
    else:
        o["status"] = "awaiting_qr"
        send_message(o["user_id"], f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Владелец отправит новый QR.')
        answer_callback(cb_id, "⚠️ Ждём новый QR")

# ========== ОБРАБОТКА ==========

def handle_update(u):
    try:
        if "message" in u:
            m = u["message"]
            chat_id = m["chat"]["id"]
            text = m.get("text", "")
            photo = m.get("photo")
            
            if photo and chat_id == OWNER_ID:
                file_id = photo[-1]["file_id"]
                logger.info(f"📸 Владелец прислал фото: file_id={file_id}")
                owner_send_qr(file_id, m.get("caption", ""))
                return
            
            if text == "/start":
                logger.info(f"🖱 /start от {chat_id}")
                send_main_menu(chat_id)
                return
            
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in u:
            cb = u["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            logger.info(f"🖱 {data} от {chat_id}")
            
            # ---- ГЛАВНОЕ МЕНЮ ----
            if data == "back_main":
                answer_callback(cb_id)
                send_main_menu(chat_id)
                return
            
            # ---- СОПРОВОЖДЕНИЯ ----
            if data == "menu_support":
                answer_callback(cb_id)
                send_replacing(chat_id, SUPPORT_PRICE_TEXT, support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    kb = {"inline_keyboard": [
                        [{"text": f"💳 Купить за {SUPPORT_PRICES[key]}₽", "callback_data": f"buysup_{key}", "style": "success"}],
                        [{"text": "Назад", "callback_data": "menu_support", "style": "primary"}]
                    ]}
                    send_replacing(chat_id, SUPPORT_DESCRIPTIONS[key], kb)
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            # ---- КОМПЛЕКТЫ ----
            if data == "menu_kits":
                answer_callback(cb_id)
                send_replacing(chat_id, KITS_TEXT, back_button())
                return
            
            # ---- СКУПКА ЛУТА ----
            if data == "menu_loot":
                answer_callback(cb_id)
                send_replacing(chat_id, LOOT_TEXT, back_button())
                return
            
            # ---- БУСТ ----
            if data == "menu_boost":
                answer_callback(cb_id)
                bt = f'<tg-emoji emoji-id="{BOOST_PRICE_EMOJI}">💎</tg-emoji> <b>ПРАЙС ЧЕРЕЗ QR</b>\n\n'
                for a, p in BOOST_PRICES:
                    bt += f'{a} — {p} ₽\n'
                send_replacing(chat_id, bt, boost_menu())
                return
            
            if data.startswith("boost_"):
                a = data.replace("boost_", "")
                for amt, pr in BOOST_PRICES:
                    if amt == a:
                        answer_callback(cb_id)
                        start_purchase(chat_id, "boost", a, f"БУСТ {a}", pr)
                        return
                return
            
            # ---- ОПЛАТА ----
            if data.startswith("paid_"):
                process_paid(chat_id, cb_id, data.replace("paid_", ""))
                return
            
            if data.startswith("cancel_"):
                pid = data.replace("cancel_", "")
                if pid in orders:
                    orders[pid]["status"] = "cancelled"
                    logger.info(f"❌ {pid}: отменён пользователем")
                answer_callback(cb_id, "❌ Отменено")
                send_replacing(
                    chat_id,
                    f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён',
                    main_menu()
                )
                return
            
            # ---- ВЛАДЕЛЕЦ ----
            if data.startswith("owner_yes_"):
                owner_confirm(cb_id, data.replace("owner_yes_", ""), True)
                return
            if data.startswith("owner_no_"):
                owner_confirm(cb_id, data.replace("owner_no_", ""), False)
                return
            if data.startswith("done_yes_"):
                owner_done(cb_id, data.replace("done_yes_", ""), True)
                return
            if data.startswith("done_no_"):
                owner_done(cb_id, data.replace("done_no_", ""), False)
                return
            
            # ---- ГРУППА ----
            if data.startswith("join_"):
                process_join(chat_id, cb_id, data.replace("join_", ""))
                return
            
            answer_callback(cb_id, "❓ Неизвестная команда")
    
    except Exception as e:
        logger.error(f"💥 handle_update: {e}")
        logger.error(traceback.format_exc())

def main():
    offset = None
    logger.info("=" * 70)
    logger.info("🚀 Бот стартует...")
    logger.info("=" * 70)
    
    while True:
        try:
            r = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            if r.get("ok"):
                for upd in r.get("result", []):
                    handle_update(upd)
                    offset = upd["update_id"] + 1
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 main: {e}")
            logger.error(traceback.format_exc())
            time.sleep(5)

if __name__ == "__main__":
    main()
