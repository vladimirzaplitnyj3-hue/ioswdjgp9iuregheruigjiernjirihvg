# ========== ХЕЛПЕРЫ ==========

def api_request(method, payload):
    url = f"{BASE_URL}/{method}"
    try:
        r = requests.post(url, json=payload, timeout=30).json()
        if not r.get("ok"):
            logger.error(f"❌ {method}: {r.get('description')}")
        return r
    except Exception as e:
        logger.error(f"💥 {method}: {e}")
        return {"ok": False}

def send_message(chat_id, text, reply_markup=None):
    p = {"chat_id": chat_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        p["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendMessage", p)

def send_photo(chat_id, photo, caption=None, reply_markup=None):
    p = {"chat_id": chat_id, "photo": photo, "parse_mode": "HTML"}
    if caption:
        p["caption"] = caption
    if reply_markup:
        p["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendPhoto", p)

def edit_message(chat_id, message_id, text, reply_markup=None):
    p = {"chat_id": chat_id, "message_id": message_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        p["reply_markup"] = json.dumps(reply_markup)
    return api_request("editMessageText", p)

def answer_callback(callback_id, text=None, show_alert=False):
    p = {"callback_query_id": callback_id}
    if text:
        p["text"] = text
    if show_alert:
        p["show_alert"] = True
    return api_request("answerCallbackQuery", p)

def delete_message(chat_id, message_id):
    return api_request("deleteMessage", {"chat_id": chat_id, "message_id": message_id})

def get_username(chat_id):
    try:
        r = api_request("getChat", {"chat_id": chat_id})
        if r.get("ok"):
            u = r["result"]
            return u.get("username") or u.get("first_name", "Пользователь")
    except:
        pass
    return "Пользователь"

def gen_order_id():
    orders_counter[0] += 1
    return f"ORD{int(time.time())}_{orders_counter[0]}"

def preview(text, limit=900):
    """Обрезаем текст для caption"""
    return text if len(text) <= limit else text[:limit-3] + "..."

