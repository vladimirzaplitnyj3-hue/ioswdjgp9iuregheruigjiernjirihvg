# ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========

def api_request(method, payload, parse_mode=None):
    """Универсальный запрос к Telegram API"""
    url = f"{BASE_URL}/{method}"
    if parse_mode and "text" in payload:
        payload["parse_mode"] = parse_mode
    try:
        response = requests.post(url, json=payload, timeout=30)
        result = response.json()
        if not result.get("ok"):
            logger.error(f"❌ Ошибка {method}: {result.get('description')}")
        return result
    except Exception as e:
        logger.error(f"💥 Критическая ошибка {method}: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

def send_message(chat_id, text, reply_markup=None):
    payload = {"chat_id": chat_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendMessage", payload)

def send_photo(chat_id, photo, caption=None, reply_markup=None):
    payload = {"chat_id": chat_id, "photo": photo, "parse_mode": "HTML"}
    if caption:
        payload["caption"] = caption
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendPhoto", payload)

def edit_message(chat_id, message_id, text, reply_markup=None):
    payload = {"chat_id": chat_id, "message_id": message_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("editMessageText", payload)

def edit_caption(chat_id, message_id, caption, reply_markup=None):
    payload = {"chat_id": chat_id, "message_id": message_id, "caption": caption, "parse_mode": "HTML"}
    if reply_markup:
        payload["reply_markup"] = json.dumps(reply_markup)
    return api_request("editMessageCaption", payload)

def answer_callback(callback_id, text=None, show_alert=False):
    payload = {"callback_query_id": callback_id}
    if text:
        payload["text"] = text
    if show_alert:
        payload["show_alert"] = True
    return api_request("answerCallbackQuery", payload)

def delete_message(chat_id, message_id):
    payload = {"chat_id": chat_id, "message_id": message_id}
    return api_request("deleteMessage", payload)

def get_username(chat_id):
    try:
        result = api_request("getChat", {"chat_id": chat_id})
        if result.get("ok"):
            user = result.get("result", {})
            username = user.get("username")
            if username:
                return username
            return user.get("first_name", "Пользователь")
        return "Пользователь"
    except:
        return "Пользователь"

def get_full_name(chat_id):
    try:
        result = api_request("getChat", {"chat_id": chat_id})
        if result.get("ok"):
            user = result.get("result", {})
            first_name = user.get("first_name", "")
            last_name = user.get("last_name", "")
            if first_name or last_name:
                return f"{first_name} {last_name}".strip()
            return "Пользователь"
        return "Пользователь"
    except:
        return "Пользователь"

def generate_order_id():
    orders_counter[0] += 1
    return f"ORD{int(time.time())}_{orders_counter[0]}"

