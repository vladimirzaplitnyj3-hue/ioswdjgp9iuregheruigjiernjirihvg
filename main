def start_purchase(chat_id, itype, ikey, iname, price):
    clear_last_message(chat_id)
    pid = gen_order_id()
    orders[pid] = {"user_id": chat_id, "type": itype, "item_key": ikey,
                   "item_name": iname, "price": price, "status": "awaiting_payment"}
    logger.info(f"🛒 {pid}: {iname} — {price}₽")
    text = (
        "📦 <b>ОПЛАТА ЗАКАЗА</b>\n\n"
        f'👤 Товар: <b>{iname}</b>\n'
        f'Сумма: <b>{price}₽</b>\n\n'
        "<b>Реквизиты:</b>\n"
        f'💳 Карта Сбер: <code>{PAY_CARD}</code>\n'
        f'📱 Телефон Сбер: <code>{PAY_PHONE}</code>\n\n'
        f'{em(EMOJI_INFO, "ℹ️")} После оплаты нажмите «Я оплатил»'
    )
    r = send_safe(chat_id, text, payment_menu(pid))
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return pid

def process_paid(chat_id, cb_id, pid):
    o = orders.get(pid)
    if not o or o["status"] != "awaiting_payment":
        answer_callback(cb_id, "⚠️ Заказ не активен", True)
        return
    o["status"] = "awaiting_owner_confirm"
    o["username"] = get_username(chat_id)
    logger.info(f"💰 {pid}: Я оплатил")
    owner_text = (
        "💰 <b>ПОДТВЕРЖДЕНИЕ</b>\n\n"
        f'👤 @{o["username"]}\n'
        f'📦 {o["item_name"]}\n'
        f'Сумма: {o["price"]}₽\n\nПришли ли вам деньги?'
    )
    send_safe(OWNER_ID, owner_text, owner_confirm_menu(pid))
    answer_callback(cb_id, "✅ Отправлено")
    send_replacing(chat_id, f'{em(EMOJI_TIME, "⏳")} Ожидайте подтверждения...')

def owner_confirm(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "awaiting_pubg_id"
        logger.info(f"✅ {pid}: подтверждено")
        send_safe(o["user_id"],
            f'{em(EMOJI_CHECK, "✅")} <b>Заказ оплачен!</b>\n\n'
            "Введите ваш PUBG ID (только цифры, до 25):")
        answer_callback(cb_id, "✅ Да")
    else:
        o["status"] = "rejected"
        logger.info(f"❌ {pid}: отменено")
        send_safe(o["user_id"], f'{em(EMOJI_CROSS, "❌")} Заказ отменён.')
        answer_callback(cb_id, "❌ Нет")

def process_pubg_id(chat_id, pid_text):
    uid = str(chat_id)
    o = None
    key = None
    for k, v in orders.items():
        if str(v.get("user_id")) == uid and v.get("status") == "awaiting_pubg_id":
            o = v
            key = k
            break
    if not o:
        return False
    o["pubg_id"] = pid_text
    o["status"] = "in_group"
    uname = o.get("username", "user")
    logger.info(f"🆔 {key}: PUBG {pid_text}")
    gt = (
        "📦 <b>СОПРОВОЖДЕНИЕ</b>\n\n"
        f'👤 @{uname}\n'
        f'🆔 PUBG ID: <code>{pid_text}</code>\n'
        f'📦 {o["item_name"]}\n'
        f'💰 {o["price"]}₽\n\n'
        f'Участвуют: @{uname}'
    )
    r = send_safe(GROUP_ID, gt, group_join_menu(key))
    if r.get("ok"):
        group_messages[key] = {"message_id": r["result"]["message_id"], "parts": [f"@{uname}"]}
        logger.info(f"✅ {key}: в группе")
    else:
        logger.error(f"❌ {key}: не в группе: {r}")
    send_safe(chat_id, f'{em(EMOJI_CHECK, "✅")} ID принят! Ожидайте QR.')
    return True

def process_join(chat_id, cb_id, pid):
    if pid not in group_messages:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    gm = group_messages[pid]
    uname = f"@{get_username(chat_id)}"
    if uname in gm["parts"]:
        answer_callback(cb_id, "⚠️ Уже участвуете", True)
        return
    if len(gm["parts"]) >= 3:
        answer_callback(cb_id, "❌ Мест нет", True)
        return
    gm["parts"].append(uname)
    answer_callback(cb_id, f"✅ ({len(gm['parts'])}/3)")
    o = orders.get(pid, {})
    nt = (
        "📦 <b>СОПРОВОЖДЕНИЕ</b>\n\n"
        f'👤 @{o.get("username", "—")}\n'
        f'🆔 <code>{o.get("pubg_id", "—")}</code>\n'
        f'📦 {o.get("item_name", "—")}\n'
        f'💰 {o.get("price", "—")}₽\n\n'
        f'Участвуют: {", ".join(gm["parts"])} ({len(gm["parts"])}/3)'
    )
    markup = None if len(gm["parts"]) >= 3 else group_join_menu(pid)
    edit_safe(GROUP_ID, gm["message_id"], nt, markup)

def owner_send_qr(file_id, caption=""):
    cnt = 0
    for pid, o in list(orders.items()):
        if o.get("status") in ("in_group", "awaiting_qr"):
            send_photo_safe(o["user_id"], file_id,
                caption=f'{em(EMOJI_INFO, "ℹ️")} <b>Ваш QR-код!</b>\n\n5 минут.\n\n' + (caption or ""))
            o["status"] = "awaiting_done"
            send_safe(OWNER_ID, f'✅ QR → {pid}', owner_done_menu(pid))
            cnt += 1
    if cnt == 0:
        send_safe(OWNER_ID, "⚠️ Нет заказов для QR")

def owner_done(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "completed"
        send_safe(o["user_id"], f'{em(EMOJI_CHECK, "✅")} Заказ выполнен!\n\nСпасибо!')
        answer_callback(cb_id, "✅ Закрыт")
    else:
        o["status"] = "awaiting_qr"
        send_safe(o["user_id"], "ℹ️ Владелец пришлёт новый QR.")
        answer_callback(cb_id, "⚠️ Ждём QR")

# ============================================================
# ОБРАБОТКА ОБНОВЛЕНИЙ
# ============================================================

def handle_update(u):
    try:
        if "message" in u:
            m = u["message"]
            chat_id = m["chat"]["id"]
            text = m.get("text", "")
            photo = m.get("photo")
            
            if photo and chat_id == OWNER_ID:
                owner_send_qr(photo[-1]["file_id"], m.get("caption", ""))
                return
            
            if text == "/start":
                logger.info(f"🖱 /start от {chat_id}")
                send_main_menu(chat_id)
                return
            
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in u:
            cb = u["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            logger.info(f"🖱 {data} от {chat_id}")
            
            if data == "back_main":
                answer_callback(cb_id)
                send_main_menu(chat_id)
                return
            
            if data == "menu_support":
                answer_callback(cb_id)
                send_replacing(chat_id, "Выберите подходящее сопровождение:", support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    kb = {"inline_keyboard": [
                        [{"text": f"💳 Купить за {SUPPORT_PRICES[key]}₽", "callback_data": f"buysup_{key}", "style": "success"}],
                        [{"text": "Назад", "callback_data": "menu_support", "style": "primary"}]
                    ]}
                    send_replacing(chat_id, SUPPORT_DESCRIPTIONS[key], kb)
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            if data == "menu_kits":
                answer_callback(cb_id)
                send_replacing(chat_id, KITS_TEXT, back_button())
                return
            
            if data == "menu_loot":
                answer_callback(cb_id)
                send_replacing(chat_id, LOOT_TEXT, back_button())
                return
            
            if data == "menu_boost":
                answer_callback(cb_id)
                bt = "<b>ПРАЙС ЧЕРЕЗ QR</b>\n\n"
                for a, p in BOOST_PRICES:
                    bt += f'{a} — {p}₽\n'
                send_replacing(chat_id, bt, boost_menu())
                return
            
            if data.startswith("boost_"):
                a = data.replace("boost_", "")
                for amt, pr in BOOST_PRICES:
                    if amt == a:
                        answer_callback(cb_id)
                        start_purchase(chat_id, "boost", a, f"БУСТ {a}", pr)
                        return
                return
            
            if data.startswith("paid_"):
                process_paid(chat_id, cb_id, data.replace("paid_", ""))
                return
            
            if data.startswith("cancel_"):
                pid = data.replace("cancel_", "")
                if pid in orders:
                    orders[pid]["status"] = "cancelled"
                answer_callback(cb_id, "❌ Отменено")
                send_replacing(chat_id, f'{em(EMOJI_CROSS, "❌")} Отменено', main_menu())
                return
            
            if data.startswith("owner_yes_"):
                owner_confirm(cb_id, data.replace("owner_yes_", ""), True)
                return
            if data.startswith("owner_no_"):
                owner_confirm(cb_id, data.replace("owner_no_", ""), False)
                return
            if data.startswith("done_yes_"):
                owner_done(cb_id, data.replace("done_yes_", ""), True)
                return
            if data.startswith("done_no_"):
                owner_done(cb_id, data.replace("done_no_", ""), False)
                return
            if data.startswith("join_"):
                process_join(chat_id, cb_id, data.replace("join_", ""))
                return
            
            answer_callback(cb_id, "❓")
    
    except Exception as e:
        logger.error(f"💥 handle_update: {e}")
        logger.error(traceback.format_exc())

# ============================================================
# УВЕДОМЛЕНИЕ О ЗАПУСКЕ
# ============================================================

def notify_startup(bot_username):
    try:
        now = datetime.datetime.now().strftime("%d.%m.%Y %H:%M:%S")
        text = (
            f'{em(EMOJI_CHECK, "✅")} <b>БОТ УСПЕШНО ЗАПУЩЕН!</b>\n\n'
            f'🤖 Бот: @{bot_username}\n'
            f'🕐 Время: {now}\n'
            f'📊 Режим: поллинг\n'
            f'👥 Группа: <code>{GROUP_ID}</code>\n'
            f'👤 Владелец: <code>{OWNER_ID}</code>\n'
            f'📸 Фото: {"✅ кэш" if PHOTO_FILE_ID else "🔄 с URL"}\n\n'
            f'<b>Готов принимать заказы!</b>'
        )
        r = send_safe(OWNER_ID, text)
        if r.get("ok"):
            logger.info("✅ Уведомление отправлено владельцу")
            return True
        logger.warning(f"⚠️ Уведомление не отправилось: {r}")
        return False
    except Exception as e:
        logger.error(f"💥 notify_startup: {e}")
        return False

# ============================================================
# ГЛАВНЫЙ ЗАПУСК
# ============================================================

def main():
    logger.info("=" * 60)
    logger.info("🚀 KRANZAYY BOT — ЗАПУСК")
    logger.info("=" * 60)
    
    # 1. Проверка интернета
    logger.info("🌐 Проверка соединения с api.telegram.org...")
    if not check_internet():
        logger.warning("⚠️ Нет доступа к api.telegram.org (DNS) — ждём...")
        while not check_internet():
            time.sleep(10)
            logger.info("🔄 Повторная проверка соединения...")
    logger.info("✅ Интернет доступен")
    
    # 2. Проверка бота
    logger.info("🔍 Проверка бота через getMe...")
    me = api_request("getMe", {})
    if not me.get("ok"):
        logger.error(f"❌ Бот не отвечает: {me}")
        logger.error("❗ Проверь токен в @BotFather — возможно, отозван.")
        return
    
    bot_username = me["result"].get("username", "unknown")
    logger.info(f"✅ Бот найден: @{bot_username}")
    
    # 3. Удаляем вебхук
    logger.info("🔧 Удаление вебхука...")
    api_request("deleteWebhook", {"drop_pending_updates": True})
    
    # 4. Отправляем уведомление
    logger.info("📨 Отправка уведомления владельцу...")
    notify_startup(bot_username)
    
    # 5. Поллинг
    offset = None
    reconnect_delay = RECONNECT_MIN
    consecutive_errors = 0
    
    logger.info("=" * 60)
    logger.info("🚀 ПОЛЛИНГ ЗАПУЩЕН — БОТ РАБОТАЕТ")
    logger.info("=" * 60)
    
    while True:
        try:
            r = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if r.get("ok"):
                # Сброс счётчика ошибок при успехе
                if consecutive_errors > 0:
                    logger.info(f"✅ Соединение восстановлено")
                consecutive_errors = 0
                reconnect_delay = RECONNECT_MIN
                network_ok[0] = True
                
                for upd in r.get("result", []):
                    handle_update(upd)
                    offset = upd["update_id"] + 1
            else:
                logger.error(f"❌ getUpdates: {r}")
            
            time.sleep(0.3)
        
        except requests.exceptions.Timeout:
            consecutive_errors += 1
            logger.warning(f"⏰ Таймаут getUpdates (ошибка #{consecutive_errors})")
            time.sleep(2)
        
        except requests.exceptions.ConnectionError as e:
            consecutive_errors += 1
            logger.error(f"🔌 Нет соединения с Telegram (ошибка #{consecutive_errors})")
            logger.error(f"   Причина: {str(e)[:150]}")
            
            # Проверяем интернет
            if not check_internet():
                logger.warning("🌐 DNS не работает — ждём восстановления сети...")
            
            # Экспоненциальная пауза
            wait = min(reconnect_delay, RECONNECT_MAX)
            logger.info(f"⏳ Переподключение через {wait} сек...")
            time.sleep(wait)
            reconnect_delay = min(reconnect_delay * 2, RECONNECT_MAX)
            continue
        
        except KeyboardInterrupt:
            logger.info("⏹ Бот остановлен вручную")
            break
        
        except Exception as e:
            consecutive_errors += 1
            logger.error(f"💥 Ошибка в main (ошибка #{consecutive_errors}): {e}")
            time.sleep(5)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        logger.info("⏹ Бот остановлен")
    except Exception as e:
        logger.error(f"💥 Фатальная ошибка: {e}")
        logger.error(traceback.format_exc())
