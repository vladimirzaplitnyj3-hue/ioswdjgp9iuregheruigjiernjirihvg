# ========== ФУНКЦИИ ПОКУПКИ ==========

def start_purchase(chat_id, item_type, item_key, item_name, price):
    """Начинает покупку — показывает реквизиты"""
    purchase_id = generate_order_id()
    orders[purchase_id] = {
        "user_id": chat_id,
        "type": item_type,
        "item_key": item_key,
        "item_name": item_name,
        "price": price,
        "status": "awaiting_payment",
        "created_at": datetime.datetime.now().isoformat()
    }
    
    text = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>ОПЛАТА ЗАКАЗА</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: <b>{item_name}</b>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: <b>{price} ₽</b>\n\n'
        f'<b>Реквизиты для оплаты:</b>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💳</tg-emoji> Карта Сбер: <code>{PAY_CARD}</code>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">📱</tg-emoji> Телефон Сбер: <code>{PAY_PHONE}</code>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> После оплаты нажмите «Я оплатил»'
    )
    
    send_message(chat_id, text, payment_menu(purchase_id))
    return purchase_id

def process_paid(chat_id, callback_id, purchase_id):
    """Пользователь нажал «Я оплатил» — отправляем владельцу"""
    order = orders.get(purchase_id)
    if not order:
        answer_callback(callback_id, "❌ Заказ не найден", True)
        return
    
    if order["status"] != "awaiting_payment":
        answer_callback(callback_id, "⚠️ Заказ уже обработан", True)
        return
    
    order["status"] = "awaiting_owner_confirm"
    order["username"] = get_username(chat_id)
    order["full_name"] = get_full_name(chat_id)
    
    owner_text = (
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Покупатель: @{order["username"]}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: {order["item_name"]}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: {order["price"]} ₽\n\n'
        f'Пришли ли вам деньги?'
    )
    
    send_message(OWNER_ID, owner_text, owner_confirm_menu(purchase_id))
    answer_callback(callback_id, "✅ Заявка отправлена владельцу")
    send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидайте подтверждения оплаты...')

def owner_confirm(chat_id, callback_id, purchase_id, yes=True):
    """Владелец подтвердил или отклонил оплату"""
    order = orders.get(purchase_id)
    if not order:
        answer_callback(callback_id, "❌ Заказ не найден", True)
        return
    
    buyer_id = order["user_id"]
    
    if yes:
        order["status"] = "awaiting_pubg_id"
        send_message(
            buyer_id,
            f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш заказ оплачен!</b>\n\n'
            f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Скоро вам придёт QR-код.\n'
            f'Зайдите в игру и вставьте этот QR-код.\n\n'
            f'<tg-emoji emoji-id="{EMOJI_USER}">🆔</tg-emoji> Введите ваш PUBG ID (только цифры, до 25 символов):'
        )
        answer_callback(callback_id, "✅ Подтверждено")
    else:
        order["status"] = "rejected_by_owner"
        send_message(
            buyer_id,
            f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> <b>Ваш заказ отменён</b>\n\n'
            f'Деньги не поступили на баланс.'
        )
        answer_callback(callback_id, "❌ Отклонено")

def process_pubg_id(chat_id, pubg_id):
    """Пользователь ввёл PUBG ID — отправляем в группу"""
    user_id = str(chat_id)
    
    # Находим заказ в статусе awaiting_pubg_id
    order = None
    order_key = None
    for oid, o in orders.items():
        if str(o.get("user_id")) == user_id and o.get("status") == "awaiting_pubg_id":
            order = o
            order_key = oid
            break
    
    if not order:
        return False
    
    order["pubg_id"] = pubg_id
    order["status"] = "in_group"
    
    username = order.get("username", "user")
    
    # Сообщение в группе
    group_text = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Купил: @{username}\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">🆔</tg-emoji> PUBG ID: <code>{pubg_id}</code>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: {order["item_name"]}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Цена: {order["price"]} ₽\n\n'
        f'Участвуют в сопровождении: @{username}'
    )
    
    result = send_message(GROUP_ID, group_text, group_join_menu(order_key))
    
    if result.get("ok"):
        message_id = result.get("result", {}).get("message_id")
        group_messages[order_key] = {
            "message_id": message_id,
            "participants": [username]
        }
        logger.info(f"✅ Сообщение о заказе {order_key} отправлено в группу")
    else:
        logger.error(f"❌ Не удалось отправить в группу: {result}")
    
    send_message(
        chat_id,
        f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш ID принят!</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Ожидайте QR-код от владельца.'
    )
    return True

def process_join_group(chat_id, callback_id, purchase_id):
    """Кто-то нажал «Я участвую» в группе"""
    if purchase_id not in group_messages:
        answer_callback(callback_id, "❌ Заказ не найден", True)
        return
    
    gm = group_messages[purchase_id]
    participants = gm["participants"]
    
    username = get_username(chat_id)
    
    if f"@{username}" in participants or username in participants:
        answer_callback(callback_id, "⚠️ Вы уже участвуете", True)
        return
    
    if len(participants) >= 3:
        answer_callback(callback_id, "❌ Мест нет (максимум 3)", True)
        return
    
    participants.append(f"@{username}")
    answer_callback(callback_id, f"✅ Вы участвуете! ({len(participants)}/3)")
    
    order = orders.get(purchase_id, {})
    buyer_username = order.get("username", "user")
    pubg_id = order.get("pubg_id", "—")
    
    participants_text = ", ".join(participants)
    
    new_text = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> Купил: @{buyer_username}\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">🆔</tg-emoji> PUBG ID: <code>{pubg_id}</code>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: {order.get("item_name", "—")}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Цена: {order.get("price", "—")} ₽\n\n'
        f'Участвуют в сопровождении: {participants_text} ({len(participants)}/3)'
    )
    
    markup = None if len(participants) >= 3 else group_join_menu(purchase_id)
    edit_message(GROUP_ID, gm["message_id"], new_text, markup)

def owner_send_qr(chat_id, photo, caption=None):
    """Владелец отправил фото — пересылаем всем покупателям в статусе in_group/awaiting_qr"""
    for oid, order in orders.items():
        if order.get("status") in ("in_group", "awaiting_qr"):
            buyer_id = order["user_id"]
            send_photo(
                buyer_id,
                photo,
                caption=(
                    f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> <b>Ваш QR-код!</b>\n\n'
                    f'У вас 5 минут, чтобы использовать этот QR-код, иначе придётся заново.\n\n'
                    + (caption or "")
                )
            )
            order["status"] = "awaiting_done"
            send_message(OWNER_ID, f'✅ QR отправлен покупателю (заказ {oid})', owner_done_menu(oid))

def owner_done(chat_id, callback_id, purchase_id, yes=True):
    """Владелец подтвердил выполнение"""
    order = orders.get(purchase_id)
    if not order:
        answer_callback(callback_id, "❌ Заказ не найден", True)
        return
    
    buyer_id = order["user_id"]
    
    if yes:
        order["status"] = "completed"
        send_message(
            buyer_id,
            f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Ваш заказ выполнен!</b>\n\n'
            f'<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> Спасибо за покупку!'
        )
        answer_callback(callback_id, "✅ Заказ закрыт")
    else:
        order["status"] = "awaiting_qr"
        send_message(
            buyer_id,
            f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Владелец отправит новый QR-код.'
        )
        answer_callback(callback_id, "⚠️ Ожидание нового QR")

# ========== ОБРАБОТКА ОБНОВЛЕНИЙ ==========

def handle_update(update):
    try:
        if "message" in update:
            msg = update["message"]
            chat_id = msg["chat"]["id"]
            user_id = str(chat_id)
            text = msg.get("text", "")
            photo = msg.get("photo")
            
            # Фото от владельца → пересылаем
            if photo and chat_id == OWNER_ID:
                file_id = photo[-1]["file_id"]
                caption = msg.get("caption", "")
                owner_send_qr(chat_id, file_id, caption)
                return
            
            if text == "/start":
                if user_id not in user_data:
                    user_data[user_id] = {"step": "main"}
                try:
                    send_photo(chat_id, PHOTO_URL, caption=MAIN_TEXT, reply_markup=main_menu())
                except:
                    send_message(chat_id, MAIN_TEXT, main_menu())
                return
            
            # PUBG ID от пользователя
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in update:
            cb = update["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            message_id = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            
            logger.info(f"🖱 {data} от {chat_id}")
            
            # ---- НАЗАД ----
            if data == "back_main":
                answer_callback(cb_id)
                try:
                    edit_caption(chat_id, message_id, MAIN_TEXT, main_menu())
                except:
                    try:
                        delete_message(chat_id, message_id)
                    except:
                        pass
                    try:
                        send_photo(chat_id, PHOTO_URL, caption=MAIN_TEXT, reply_markup=main_menu())
                    except:
                        send_message(chat_id, MAIN_TEXT, main_menu())
                return
            
            # ---- СОПРОВОЖДЕНИЯ ----
            if data == "menu_support":
                answer_callback(cb_id)
                send_message(chat_id, SUPPORT_PRICE_TEXT, support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    send_message(
                        chat_id,
                        SUPPORT_DESCRIPTIONS[key],
                        {"inline_keyboard": [[{"text": f"Купить за {SUPPORT_PRICES[key]}₽", "callback_data": f"buysup_{key}", "style": "success"}], [{"text": "Назад", "callback_data": "menu_support", "style": "primary"}]]}
                    )
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            # ---- КОМПЛЕКТЫ ----
            if data == "menu_kits":
                answer_callback(cb_id)
                send_message(chat_id, KITS_TEXT, {"inline_keyboard": [[{"text": "Назад", "callback_data": "back_main", "style": "primary"}]]})
                return
            
            # ---- СКУПКА ЛУТА ----
            if data == "menu_loot":
                answer_callback(cb_id)
                send_message(chat_id, LOOT_TEXT, {"inline_keyboard": [[{"text": "Назад", "callback_data": "back_main", "style": "primary"}]]})
                return
            
            # ---- БУСТ БАЛАНСА ----
            if data == "menu_boost":
                answer_callback(cb_id)
                boost_text = (
                    f'<tg-emoji emoji-id="{BOOST_PRICE_EMOJI}">💎</tg-emoji> <b>ПРАЙС ЧЕРЕЗ QR</b>\n\n'
                )
                for amount, price in BOOST_PRICES:
                    boost_text += (
                        f'<tg-emoji emoji-id="{BOOST_DOT}">➖</tg-emoji>'
                        f'{amount} '
                        f'<tg-emoji emoji-id="{BOOST_LINE}">—</tg-emoji>'
                        f' {price} '
                        f'<tg-emoji emoji-id="{BOOST_END}">💰</tg-emoji>\n'
                    )
                send_message(chat_id, boost_text, boost_menu())
                return
            
            if data.startswith("boost_"):
                amount = data.replace("boost_", "")
                price = None
                for amt, pr in BOOST_PRICES:
                    if amt == amount:
                        price = pr
                        break
                if price:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "boost", amount, f"БУСТ {amount}", price)
                return
            
            # ---- ОПЛАТА ----
            if data.startswith("paid_"):
                purchase_id = data.replace("paid_", "")
                process_paid(chat_id, cb_id, purchase_id)
                return
            
            if data.startswith("cancel_"):
                purchase_id = data.replace("cancel_", "")
                if purchase_id in orders:
                    orders[purchase_id]["status"] = "cancelled"
                answer_callback(cb_id, "❌ Отменено")
                send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён')
                return
            
            # ---- ВЛАДЕЛЕЦ ----
            if data.startswith("owner_yes_"):
                purchase_id = data.replace("owner_yes_", "")
                owner_confirm(chat_id, cb_id, purchase_id, yes=True)
                return
            
            if data.startswith("owner_no_"):
                purchase_id = data.replace("owner_no_", "")
                owner_confirm(chat_id, cb_id, purchase_id, yes=False)
                return
            
            if data.startswith("done_yes_"):
                purchase_id = data.replace("done_yes_", "")
                owner_done(chat_id, cb_id, purchase_id, yes=True)
                return
            
            if data.startswith("done_no_"):
                purchase_id = data.replace("done_no_", "")
                owner_done(chat_id, cb_id, purchase_id, yes=False)
                return
            
            # ---- УЧАСТИЕ В ГРУППЕ ----
            if data.startswith("join_"):
                purchase_id = data.replace("join_", "")
                process_join_group(chat_id, cb_id, purchase_id)
                return
            
            answer_callback(cb_id, "❓ Неизвестная команда")
    
    except Exception as e:
        logger.error(f"💥 ОШИБКА В HANDLE_UPDATE: {e}")
        logger.error(traceback.format_exc())

# ========== ЗАПУСК ==========

def main():
    offset = None
    logger.info("=" * 70)
    logger.info("🚀 БОТ ЗАПУЩЕН")
    logger.info("=" * 70)
    
    while True:
        try:
            response = requests.get(
                f"{BASE_URL}/getUpdates",
                params={"timeout": 30, "offset": offset},
                timeout=35
            ).json()
            
            if response.get("ok"):
                for update in response.get("result", []):
                    handle_update(update)
                    offset = update["update_id"] + 1
            else:
                logger.error(f"❌ Ошибка getUpdates: {response}")
            
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 Ошибка в main: {e}")
            logger.error(traceback.format_exc())
            time.sleep(5)

if __name__ == "__main__":
    main()
