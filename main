def sup(name, garant, veshi, kartа, garant_v, price, vydacha=False, garanty=None):
    text = f'{name}\n\nгарант: {garant}\n\n'
    if vydacha:
        text += f'выдаем: <tg-emoji emoji-id="{E1}">🎁</tg-emoji><tg-emoji emoji-id="{E2}">🎁</tg-emoji><tg-emoji emoji-id="{E3}">🎁</tg-emoji><tg-emoji emoji-id="{E4}">🎁</tg-emoji>\n'
        text += f'если снимают, возвращаем <tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji>\n\n'
    else:
        text += f'Вещи с типов ваши\n\nкарта: {kartа}\n\nгарант вещей: {garant_v}\n\n'
        text += f'Выдача: <tg-emoji emoji-id="{E1}">🎁</tg-emoji><tg-emoji emoji-id="{E2}">🎁</tg-emoji><tg-emoji emoji-id="{E3}">🎁</tg-emoji><tg-emoji emoji-id="{E4}">🎁</tg-emoji> Если с вас снимают, не возвращаем <tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji>\n\n'
    
    if garanty:
        text += f'ГАРАНТЫ\n\n{garanty}\n\n'
    
    text += f'цена <tg-emoji emoji-id="{EMOJI_DASH}">➖</tg-emoji>{price} <tg-emoji emoji-id="{EMOJI_MONEY}">₽</tg-emoji>'
    return text

