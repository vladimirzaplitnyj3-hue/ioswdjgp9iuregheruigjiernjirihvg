# ========== УТИЛИТЫ ==========

def api_request(method, payload, log_full=True):
    url = f"{BASE_URL}/{method}"
    try:
        if log_full:
            logger.debug(f"📤 {method}: {json.dumps(payload, ensure_ascii=False)[:250]}")
        r = requests.post(url, json=payload, timeout=30).json()
        if r.get("ok"):
            logger.debug(f"✅ {method} OK")
        else:
            logger.error(f"❌ {method}: {r.get('error_code')} — {r.get('description')}")
        return r
    except requests.exceptions.Timeout:
        logger.error(f"⏰ Таймаут {method}")
        return {"ok": False, "error": "timeout"}
    except requests.exceptions.ConnectionError:
        logger.error(f"🔌 Ошибка подключения {method}")
        return {"ok": False, "error": "connection"}
    except Exception as e:
        logger.error(f"💥 {method}: {e}")
        logger.error(traceback.format_exc())
        return {"ok": False, "error": str(e)}

def send_message(chat_id, text, reply_markup=None):
    p = {"chat_id": chat_id, "text": text, "parse_mode": "HTML"}
    if reply_markup:
        p["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendMessage", p)

def send_photo(chat_id, photo, caption=None, reply_markup=None):
    p = {"chat_id": chat_id, "photo": photo, "parse_mode": "HTML"}
    if caption:
        p["caption"] = caption
    if reply_markup:
        p["reply_markup"] = json.dumps(reply_markup)
    return api_request("sendPhoto", p)

def answer_callback(cb_id, text=None, alert=False):
    p = {"callback_query_id": cb_id}
    if text:
        p["text"] = text
    if alert:
        p["show_alert"] = True
    return api_request("answerCallbackQuery", p, log_full=False)

def delete_message(chat_id, message_id):
    return api_request("deleteMessage", {"chat_id": chat_id, "message_id": message_id}, log_full=False)

def get_username(chat_id):
    try:
        r = api_request("getChat", {"chat_id": chat_id}, log_full=False)
        if r.get("ok"):
            u = r["result"]
            return u.get("username") or u.get("first_name", "Пользователь")
    except:
        pass
    return "Пользователь"

def gen_order_id():
    orders_counter[0] += 1
    return f"ORD{int(time.time())}_{orders_counter[0]}"

def safe_truncate(text, limit):
    """Обрезка текста без разрыва HTML-тегов"""
    if len(text) <= limit:
        return text
    result = []
    open_tags = []
    i = 0
    while i < len(text) and len(''.join(result)) < limit:
        if text[i] == '<':
            end = text.find('>', i)
            if end == -1:
                break
            tag = text[i:end+1]
            if tag.startswith('</'):
                tag_name = tag[2:-1].split()[0]
                if tag_name in open_tags:
                    open_tags.remove(tag_name)
                result.append(tag)
            else:
                tag_name = tag[1:-1].split()[0]
                open_tags.append(tag_name)
                result.append(tag)
            i = end + 1
        else:
            result.append(text[i])
            i += 1
    for tag_name in reversed(open_tags):
        result.append(f'</{tag_name}>')
    return ''.join(result)

# ========== УПРАВЛЕНИЕ СООБЩЕНИЯМИ ==========

def remember_message(user_id, message_id):
    uid = str(user_id)
    if uid not in user_data:
        user_data[uid] = {}
    user_data[uid]["last_msg_id"] = message_id

def clear_last_message(user_id):
    uid = str(user_id)
    last_id = user_data.get(uid, {}).get("last_msg_id")
    if last_id:
        delete_message(user_id, last_id)
    if uid in user_data:
        user_data[uid]["last_msg_id"] = None

