        [{"text": "ЭЛИТ — 290₽", "callback_data": "sup_elite", "style": "success"}],
        [{"text": "ОЛИГАРХ — 359₽", "callback_data": "sup_oligarch", "style": "success"}],
        [{"text": "ДЕФОЛТ+ — 150₽", "callback_data": "sup_default_plus", "style": "primary"}],
        [{"text": "ВИП+ — 210₽", "callback_data": "sup_vip_plus", "style": "primary"}],
        [{"text": "ЭЛИТ+ — 290₽", "callback_data": "sup_elite_plus", "style": "primary"}],
        [{"text": "ОЛИГАРХ+ — 425₽", "callback_data": "sup_oligarch_plus", "style": "primary"}],
        [{"text": "ДЕФОЛТ ПРО — 225₽", "callback_data": "sup_default_pro", "style": "danger"}],
        [{"text": "ВИП ПРО — 289₽", "callback_data": "sup_vip_pro", "style": "danger"}],
        [{"text": "ЭЛИТ ПРО — 369₽", "callback_data": "sup_elite_pro", "style": "danger"}],
        [{"text": "ОЛИГАРХ ПРО — 529₽", "callback_data": "sup_oligarch_pro", "style": "danger"}],
        [{"text": "Назад", "callback_data": "back_main", "style": "primary"}],
    ]}

def boost_menu():
    kb = [[{"text": f"{a} — {p}₽", "callback_data": f"boost_{a}", "style": "success"}] for a, p in BOOST_PRICES]
    kb.append([{"text": "Назад", "callback_data": "back_main", "style": "primary"}])
    return {"inline_keyboard": kb}

def back_button(cb="back_main"):
    return {"inline_keyboard": [[{"text": "Назад", "callback_data": cb, "style": "primary"}]]}

def payment_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Я оплатил", "callback_data": f"paid_{pid}", "style": "success", "icon_custom_emoji_id": EMOJI_CHECK}],
        [{"text": "Не хочу оплачивать", "callback_data": f"cancel_{pid}", "style": "danger", "icon_custom_emoji_id": EMOJI_CROSS}],
    ]}

def owner_confirm_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Да, деньги пришли", "callback_data": f"owner_yes_{pid}", "style": "success", "icon_custom_emoji_id": EMOJI_CHECK}],
        [{"text": "Нет, отменить", "callback_data": f"owner_no_{pid}", "style": "danger", "icon_custom_emoji_id": EMOJI_CROSS}],
    ]}

def owner_done_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Заказ выполнен — Да", "callback_data": f"done_yes_{pid}", "style": "success", "icon_custom_emoji_id": EMOJI_CHECK}],
        [{"text": "Заказ выполнен — Нет", "callback_data": f"done_no_{pid}", "style": "danger", "icon_custom_emoji_id": EMOJI_CROSS}],
    ]}

def group_join_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Я участвую в сопровождении", "callback_data": f"join_{pid}", "style": "success", "icon_custom_emoji_id": EMOJI_USER}]
    ]}

# ========== ОТПРАВКА ГЛАВНОГО МЕНЮ ==========

def send_main_menu(chat_id):
    global PHOTO_FILE_ID
    logger.info(f"📸 send_main_menu → {chat_id}")
    clear_last_message(chat_id)
    photo = PHOTO_FILE_ID or PHOTO_URL
    r = send_photo_safe(chat_id, photo, caption=MAIN_CAPTION, reply_markup=main_menu())
    if r.get("ok"):
        logger.info(f"✅ Фото+caption отправлено")
        if not PHOTO_FILE_ID:
            try:
                PHOTO_FILE_ID = r["result"]["photo"][-1]["file_id"]
                logger.info(f"💾 file_id: {PHOTO_FILE_ID}")
                logger.info(f'💾 Вставь в код: PHOTO_FILE_ID = "{PHOTO_FILE_ID}"')
            except Exception as e:
                logger.error(f"⚠️ file_id: {e}")
        remember_message(chat_id, r["result"]["message_id"])
    else:
        logger.error(f"❌ Фото fail: {r.get('description')}")
        r2 = send_safe(chat_id, MAIN_TEXT, main_menu())
        if r2.get("ok"):
            remember_message(chat_id, r2["result"]["message_id"])
    return r

def send_replacing(chat_id, text, reply_markup=None):
    clear_last_message(chat_id)
    r = send_safe(chat_id, text, reply_markup)
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return r

# ========== ЛОГИКА ==========

def start_purchase(chat_id, itype, ikey, iname, price):
    clear_last_message(chat_id)
    pid = gen_order_id()
    orders[pid] = {"user_id": chat_id, "type": itype, "item_key": ikey,
                   "item_name": iname, "price": price, "status": "awaiting_payment"}
    logger.info(f"🛒 {pid}: {iname} — {price}₽")
    text = (
        f'{e(EMOJI_ORDER, "📦")} <b>ОПЛАТА ЗАКАЗА</b>\n\n'
        f'{e(EMOJI_MONEY, "💰")} Товар: <b>{iname}</b>\n'
        f'{e(EMOJI_MONEY, "💰")} Сумма: <b>{price} {e(EMOJI_RUB, "₽")}</b>\n\n'
        f'<b>Реквизиты:</b>\n'
        f'💳 Сбер Карта: <code>{PAY_CARD}</code>\n'
        f'📱 Сбер Телефон: <code>{PAY_PHONE}</code>\n\n'
        f'{e(EMOJI_INFO, "ℹ️")} После оплаты нажмите «Я оплатил»'
    )
    r = send_safe(chat_id, text, payment_menu(pid))
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return pid

def process_paid(chat_id, cb_id, pid):
    o = orders.get(pid)
    if not o or o["status"] != "awaiting_payment":
        answer_callback(cb_id, "⚠️ Заказ не активен", True)
        return
    o["status"] = "awaiting_owner_confirm"
    o["username"] = get_username(chat_id)
    logger.info(f"💰 {pid}: нажал Я оплатил")
    owner_text = (
        f'{e(EMOJI_MONEY, "💰")} <b>ПОДТВЕРЖДЕНИЕ</b>\n\n'
        f'{e(EMOJI_USER, "👤")} @{o["username"]}\n'
        f'{e(EMOJI_MONEY, "💰")} {o["item_name"]}\n'
        f'Сумма: {o["price"]} {e(EMOJI_RUB, "₽")}\n\nПришли ли вам деньги?'
    )
    send_safe(OWNER_ID, owner_text, owner_confirm_menu(pid))
    answer_callback(cb_id, "✅ Отправлено")
    send_replacing(chat_id, f'{e(EMOJI_TIME, "⏳")} Ожидайте подтверждения...')

def owner_confirm(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "awaiting_pubg_id"
        logger.info(f"✅ {pid}: подтверждено")
        send_safe(o["user_id"],
            f'{e(EMOJI_CHECK, "✅")} <b>Заказ оплачен!</b>\n\n'
            f'Введите ваш PUBG ID (только цифры, до 25):')
        answer_callback(cb_id, "✅ Да")
    else:
        o["status"] = "rejected"
        logger.info(f"❌ {pid}: отменено")
        send_safe(o["user_id"], f'{e(EMOJI_CROSS, "❌")} Заказ отменён.')
        answer_callback(cb_id, "❌ Нет")

def process_pubg_id(chat_id, pid_text):
    uid = str(chat_id)
    o = None
    key = None
    for k, v in orders.items():
        if str(v.get("user_id")) == uid and v.get("status") == "awaiting_pubg_id":
            o = v
            key = k
            break
    if not o:
        return False
    o["pubg_id"] = pid_text
    o["status"] = "in_group"
    uname = o.get("username", "user")
    logger.info(f"🆔 {key}: PUBG {pid_text}")
    gt = (
        f'{e(EMOJI_ORDER, "📦")} <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'{e(EMOJI_USER, "👤")} @{uname}\n'
        f'🆔 PUBG ID: <code>{pid_text}</code>\n'
        f'📦 {o["item_name"]}\n'
        f'💰 {o["price"]} {e(EMOJI_RUB, "₽")}\n\n'
        f'Участвуют: @{uname}'
    )
    r = send_safe(GROUP_ID, gt, group_join_menu(key))
    if r.get("ok"):
        group_messages[key] = {"message_id": r["result"]["message_id"], "parts": [f"@{uname}"]}
        logger.info(f"✅ {key}: в группе")
    send_safe(chat_id, f'{e(EMOJI_CHECK, "✅")} ID принят! Ожидайте QR.')
    return True

def process_join(chat_id, cb_id, pid):
    if pid not in group_messages:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    gm = group_messages[pid]
    uname = f"@{get_username(chat_id)}"
    if uname in gm["parts"]:
        answer_callback(cb_id, "⚠️ Уже участвуете", True)
        return
    if len(gm["parts"]) >= 3:
        answer_callback(cb_id, "❌ Мест нет", True)
        return
    gm["parts"].append(uname)
    answer_callback(cb_id, f"✅ ({len(gm['parts'])}/3)")
    o = orders.get(pid, {})
    nt = (
        f'{e(EMOJI_ORDER, "📦")} <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'{e(EMOJI_USER, "👤")} @{o.get("username", "—")}\n'
        f'🆔 <code>{o.get("pubg_id", "—")}</code>\n'
        f'📦 {o.get("item_name", "—")}\n'
        f'💰 {o.get("price", "—")} {e(EMOJI_RUB, "₽")}\n\n'
        f'Участвуют: {", ".join(gm["parts"])} ({len(gm["parts"])}/3)'
    )
    markup = None if len(gm["parts"]) >= 3 else group_join_menu(pid)
    edit_safe(GROUP_ID, gm["message_id"], nt, markup)

def owner_send_qr(file_id, caption=""):
    cnt = 0
    for pid, o in list(orders.items()):
        if o.get("status") in ("in_group", "awaiting_qr"):
            send_photo_safe(o["user_id"], file_id,
                caption=f'{e(EMOJI_INFO, "ℹ️")} <b>Ваш QR-код!</b>\n\n5 минут.\n\n' + (caption or ""))
            o["status"] = "awaiting_done"
            send_safe(OWNER_ID, f'✅ QR → {pid}', owner_done_menu(pid))
            cnt += 1
    if cnt == 0:
        send_safe(OWNER_ID, "⚠️ Нет заказов")

def owner_done(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "completed"
        send_safe(o["user_id"], f'{e(EMOJI_CHECK, "✅")} Заказ выполнен!\n\nСпасибо!')
        answer_callback(cb_id, "✅ Закрыт")
    else:
        o["status"] = "awaiting_qr"
        send_safe(o["user_id"], "ℹ️ Владелец пришлёт новый QR.")
        answer_callback(cb_id, "⚠️ Ждём QR")

# ========== ОБРАБОТКА ==========

def handle_update(u):
    try:
        if "message" in u:
            m = u["message"]
            chat_id = m["chat"]["id"]
            text = m.get("text", "")
            photo = m.get("photo")
            if photo and chat_id == OWNER_ID:
                owner_send_qr(photo[-1]["file_id"], m.get("caption", ""))
                return
            if text == "/start":
                logger.info(f"🖱 /start от {chat_id}")
                send_main_menu(chat_id)
                return
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in u:
            cb = u["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            logger.info(f"🖱 {data} от {chat_id}")
            
            if data == "back_main":
                answer_callback(cb_id)
                send_main_menu(chat_id)
                return
            
            if data == "menu_support":
                answer_callback(cb_id)
                send_replacing(chat_id, SUPPORT_PRICE_TEXT, support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    kb = {"inline_keyboard": [
                        [{"text": f"💳 Купить за {SUPPORT_PRICES[key]}₽", "callback_data": f"buysup_{key}", "style": "success"}],
                        [{"text": "Назад", "callback_data": "menu_support", "style": "primary"}]
                    ]}
                    logger.info(f"📝 Отправка описания {key}")
                    send_replacing(chat_id, SUPPORT_DESCRIPTIONS[key], kb)
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            if data == "menu_kits":
                answer_callback(cb_id)
                send_replacing(chat_id, KITS_TEXT, back_button())
                return
            
            if data == "menu_loot":
                answer_callback(cb_id)
                send_replacing(chat_id, LOOT_TEXT, back_button())
                return
            
            if data == "menu_boost":
                answer_callback(cb_id)
                bt = f'{e(BOOST_PRICE_EMOJI, "💎")} <b>ПРАЙС</b>\n\n'
                for a, p in BOOST_PRICES:
                    bt += f'{a} — {p} {e(EMOJI_RUB, "₽")}\n'
                send_replacing(chat_id, bt, boost_menu())
                return
            
            if data.startswith("boost_"):
                a = data.replace("boost_", "")
                for amt, pr in BOOST_PRICES:
                    if amt == a:
                        answer_callback(cb_id)
                        start_purchase(chat_id, "boost", a, f"БУСТ {a}", pr)
                        return
                return
            
            if data.startswith("paid_"):
                process_paid(chat_id, cb_id, data.replace("paid_", ""))
                return
            
            if data.startswith("cancel_"):
                pid = data.replace("cancel_", "")
                if pid in orders:
                    orders[pid]["status"] = "cancelled"
                answer_callback(cb_id, "❌ Отменено")
                send_replacing(chat_id, f'{e(EMOJI_CROSS, "❌")} Отменено', main_menu())
                return
            
            if data.startswith("owner_yes_"):
                owner_confirm(cb_id, data.replace("owner_yes_", ""), True)
                return
            if data.startswith("owner_no_"):
                owner_confirm(cb_id, data.replace("owner_no_", ""), False)
                return
            if data.startswith("done_yes_"):
                owner_done(cb_id, data.replace("done_yes_", ""), True)
                return
            if data.startswith("done_no_"):
                owner_done(cb_id, data.replace("done_no_", ""), False)
                return
            if data.startswith("join_"):
                process_join(chat_id, cb_id, data.replace("join_", ""))
                return
            
            answer_callback(cb_id, "❓")
    
    except Exception as e:
        logger.error(f"💥 {e}")
        logger.error(traceback.format_exc())

def main():
    offset = None
    logger.info("🚀 Старт")
    while True:
        try:
            r = requests.get(f"{BASE_URL}/getUpdates", params={"timeout": 30, "offset": offset}, timeout=35).json()
            if r.get("ok"):
                for upd in r.get("result", []):
                    handle_update(upd)
                    offset = upd["update_id"] + 1
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 main: {e}")
            time.sleep(5)

if __name__ == "__main__":
    main()
