# ========== ОТПРАВКА МЕНЮ С FALLBACK ==========

def send_main_menu(chat_id):
    global PHOTO_FILE_ID
    photo = PHOTO_FILE_ID or PHOTO_URL
    # caption ограничен 1024, проверим длину
    caption = preview(MAIN_TEXT, 1000)
    
    r = send_photo(chat_id, photo, caption=caption, reply_markup=main_menu())
    if r.get("ok"):
        if not PHOTO_FILE_ID:
            try:
                PHOTO_FILE_ID = r["result"]["photo"][-1]["file_id"]
                logger.info(f"✅ file_id сохранён: {PHOTO_FILE_ID}")
            except:
                pass
        return r
    
    logger.warning(f"⚠️ Фото не сработало: {r.get('description')}")
    # Отправляем текст без фото
    r2 = send_message(chat_id, MAIN_TEXT, main_menu())
    if not r2.get("ok"):
        # Если и текст не сработал (слишком длинный) — обрезаем
        logger.warning(f"⚠️ Текст не сработал: {r2.get('description')}")
        send_message(chat_id, preview(MAIN_TEXT, 3500), main_menu())
    return r2

# ========== ЛОГИКА ПОКУПКИ ==========

def start_purchase(chat_id, itype, ikey, iname, price):
    pid = gen_order_id()
    orders[pid] = {"user_id": chat_id, "type": itype, "item_key": ikey,
                   "item_name": iname, "price": price, "status": "awaiting_payment"}
    text = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>ОПЛАТА ЗАКАЗА</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Товар: <b>{iname}</b>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> Сумма: <b>{price} ₽</b>\n\n'
        f'<b>Реквизиты:</b>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💳</tg-emoji> Сбер Карта: <code>{PAY_CARD}</code>\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">📱</tg-emoji> Сбер Телефон: <code>{PAY_PHONE}</code>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> После оплаты нажмите «Я оплатил»'
    )
    send_message(chat_id, text, payment_menu(pid))
    return pid

def process_paid(chat_id, cb_id, pid):
    o = orders.get(pid)
    if not o or o["status"] != "awaiting_payment":
        answer_callback(cb_id, "⚠️ Заказ не активен", True)
        return
    o["status"] = "awaiting_owner_confirm"
    o["username"] = get_username(chat_id)
    owner_text = (
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> <b>ПОДТВЕРЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> @{o["username"]}\n'
        f'<tg-emoji emoji-id="{EMOJI_MONEY}">💰</tg-emoji> {o["item_name"]}\n'
        f'Сумма: {o["price"]} ₽\n\nПришли ли вам деньги?'
    )
    send_message(OWNER_ID, owner_text, owner_confirm_menu(pid))
    answer_callback(cb_id, "✅ Отправлено")
    send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_TIME}">⏳</tg-emoji> Ожидайте...')

def owner_confirm(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "awaiting_pubg_id"
        send_message(o["user_id"],
            f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Заказ оплачен!</b>\n\n'
            f'Скоро придёт QR-код.\nЗайдите в игру и вставьте его.\n\n'
            f'Введите ваш PUBG ID (только цифры, до 25):')
        answer_callback(cb_id, "✅ Да")
    else:
        o["status"] = "rejected"
        send_message(o["user_id"], f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён.')
        answer_callback(cb_id, "❌ Нет")

def process_pubg_id(chat_id, pid_text):
    uid = str(chat_id)
    o = None
    key = None
    for k, v in orders.items():
        if str(v.get("user_id")) == uid and v.get("status") == "awaiting_pubg_id":
            o = v
            key = k
            break
    if not o:
        return False
    
    o["pubg_id"] = pid_text
    o["status"] = "in_group"
    uname = o.get("username", "user")
    
    gt = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> @{uname}\n'
        f'PUBG ID: <code>{pid_text}</code>\n'
        f'Товар: {o["item_name"]}\n'
        f'Цена: {o["price"]} ₽\n\n'
        f'Участвуют: @{uname}'
    )
    r = send_message(GROUP_ID, gt, group_join_menu(key))
    if r.get("ok"):
        group_messages[key] = {"message_id": r["result"]["message_id"], "parts": [f"@{uname}"]}
    send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> ID принят! Ожидайте QR.')
    return True

def process_join(chat_id, cb_id, pid):
    if pid not in group_messages:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    gm = group_messages[pid]
    uname = f"@{get_username(chat_id)}"
    if uname in gm["parts"]:
        answer_callback(cb_id, "⚠️ Вы уже участвуете", True)
        return
    if len(gm["parts"]) >= 3:
        answer_callback(cb_id, "❌ Мест нет", True)
        return
    gm["parts"].append(uname)
    answer_callback(cb_id, f"✅ Участвуете! ({len(gm['parts'])}/3)")
    
    o = orders.get(pid, {})
    nt = (
        f'<tg-emoji emoji-id="{EMOJI_ORDER}">📦</tg-emoji> <b>СОПРОВОЖДЕНИЕ</b>\n\n'
        f'<tg-emoji emoji-id="{EMOJI_USER}">👤</tg-emoji> @{o.get("username", "—")}\n'
        f'PUBG ID: <code>{o.get("pubg_id", "—")}</code>\n'
        f'Товар: {o.get("item_name", "—")}\n'
        f'Цена: {o.get("price", "—")} ₽\n\n'
        f'Участвуют: {", ".join(gm["parts"])} ({len(gm["parts"])}/3)'
    )
    markup = None if len(gm["parts"]) >= 3 else group_join_menu(pid)
    edit_message(GROUP_ID, gm["message_id"], nt, markup)

def owner_send_qr(file_id, caption=""):
    cnt = 0
    for pid, o in list(orders.items()):
        if o.get("status") in ("in_group", "awaiting_qr"):
            send_photo(o["user_id"], file_id,
                caption=f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> <b>Ваш QR-код!</b>\n\n5 минут на использование, иначе заново.\n\n' + caption)
            o["status"] = "awaiting_done"
            send_message(OWNER_ID, f'✅ QR → заказ {pid}', owner_done_menu(pid))
            cnt += 1
    if cnt == 0:
        send_message(OWNER_ID, "⚠️ Нет заказов для QR")

def owner_done(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, "❌ Не найден", True)
        return
    if yes:
        o["status"] = "completed"
        send_message(o["user_id"], f'<tg-emoji emoji-id="{EMOJI_CHECK}">✅</tg-emoji> <b>Заказ выполнен!</b>\n\n<tg-emoji emoji-id="{EMOJI_HEART}">❤️‍🔥</tg-emoji> Спасибо!')
        answer_callback(cb_id, "✅ Закрыт")
    else:
        o["status"] = "awaiting_qr"
        send_message(o["user_id"], f'<tg-emoji emoji-id="{EMOJI_INFO}">ℹ️</tg-emoji> Владелец отправит новый QR.')
        answer_callback(cb_id, "⚠️ Ждём QR")

# ========== ОБРАБОТКА ==========

def handle_update(u):
    try:
        if "message" in u:
            m = u["message"]
            chat_id = m["chat"]["id"]
            text = m.get("text", "")
            photo = m.get("photo")
            
            if photo and chat_id == OWNER_ID:
                owner_send_qr(photo[-1]["file_id"], m.get("caption", ""))
                return
            
            if text == "/start":
                send_main_menu(chat_id)
                return
            
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in u:
            cb = u["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            mid = cb["message"]["message_id"]
            data = cb["data"]
            cb_id = cb["id"]
            logger.info(f"🖱 {data} от {chat_id}")
            
            if data == "back_main":
                answer_callback(cb_id)
                try:
                    delete_message(chat_id, mid)
                except:
                    pass
                send_main_menu(chat_id)
                return
            
            if data == "menu_support":
                answer_callback(cb_id)
                send_message(chat_id, SUPPORT_PRICE_TEXT, support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    send_message(chat_id, SUPPORT_DESCRIPTIONS[key],
                        {"inline_keyboard": [
                            [{"text": f"Купить за {SUPPORT_PRICES[key]}₽", "callback_data": f"buysup_{key}", "style": "success"}],
                            [{"text": "Назад", "callback_data": "menu_support", "style": "primary"}]
                        ]})
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            if data == "menu_kits":
                answer_callback(cb_id)
                send_message(chat_id, KITS_TEXT, {"inline_keyboard": [[{"text": "Назад", "callback_data": "back_main", "style": "primary"}]]})
                return
            
            if data == "menu_loot":
                answer_callback(cb_id)
                send_message(chat_id, LOOT_TEXT, {"inline_keyboard": [[{"text": "Назад", "callback_data": "back_main", "style": "primary"}]]})
                return
            
            if data == "menu_boost":
                answer_callback(cb_id)
                # ПРОСТОЙ ТЕКСТ без вложенных эмодзи-тегов
                bt = f'<tg-emoji emoji-id="{BOOST_PRICE_EMOJI}">💎</tg-emoji> <b>ПРАЙС ЧЕРЕЗ QR</b>\n\n'
                for a, p in BOOST_PRICES:
                    bt += f'{a} — {p} ₽\n'
                send_message(chat_id, bt, boost_menu())
                return
            
            if data.startswith("boost_"):
                a = data.replace("boost_", "")
                for amt, pr in BOOST_PRICES:
                    if amt == a:
                        answer_callback(cb_id)
                        start_purchase(chat_id, "boost", a, f"БУСТ {a}", pr)
                        return
                return
            
            if data.startswith("paid_"):
                process_paid(chat_id, cb_id, data.replace("paid_", ""))
                return
            
            if data.startswith("cancel_"):
                pid = data.replace("cancel_", "")
                if pid in orders:
                    orders[pid]["status"] = "cancelled"
                answer_callback(cb_id, "❌ Отменено")
                send_message(chat_id, f'<tg-emoji emoji-id="{EMOJI_CROSS}">❌</tg-emoji> Заказ отменён')
                return
            
            if data.startswith("owner_yes_"):
                owner_confirm(cb_id, data.replace("owner_yes_", ""), True)
                return
            if data.startswith("owner_no_"):
                owner_confirm(cb_id, data.replace("owner_no_", ""), False)
                return
            if data.startswith("done_yes_"):
                owner_done(cb_id, data.replace("done_yes_", ""), True)
                return
            if data.startswith("done_no_"):
                owner_done(cb_id, data.replace("done_no_", ""), False)
                return
            if data.startswith("join_"):
                process_join(chat_id, cb_id, data.replace("join_", ""))
                return
            
            answer_callback(cb_id, "❓ Неизвестно")
    
    except Exception as e:
        logger.error(f"💥 {e}")
        logger.error(traceback.format_exc())

def main():
    offset = None
    logger.info("🚀 Старт")
    while True:
        try:
            r = requests.get(f"{BASE_URL}/getUpdates", params={"timeout": 30, "offset": offset}, timeout=35).json()
            if r.get("ok"):
                for upd in r.get("result", []):
                    handle_update(upd)
                    offset = upd["update_id"] + 1
            time.sleep(0.5)
        except Exception as e:
            logger.error(f"💥 main: {e}")
            time.sleep(5)

if __name__ == "__main__":
    main()
